{
  "name": "minecraft-ai-bot",
  "private": true,
  "version": "0.1.0",
  "description": "Autonomous Minecraft Java bot (Mineflayer, vanilla 1.21.4)",
  "license": "UNLICENSED",
  "type": "module",
  "engines": {
    "node": ">=22 <23"
  },
  "scripts": {
    "build": "tsc --noEmit -p .",
    "test": "vitest run",
    "bot": "tsx src/bot/main.ts",
    "eval": "tsx src/evaluation/cli.ts eval",
    "navbench": "tsx src/evaluation/cli.ts eval --scenario navbench",
    "inspect": "tsx src/evaluation/cli.ts inspect",
    "setup": "tsx src/evaluation/setup.ts",
    "test:scenario": "vitest run -c vitest.scenario.config.ts"
  },
  "dependencies": {
    "minecraft-wrap": "1.10.0",
    "mineflayer": "4.39.0",
    "mineflayer-pathfinder": "github:PrismarineJS/mineflayer-pathfinder#6f5c26bf79e7861d20e0fbc735059db51e4d8f77",
    "vec3": "0.1.10",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@types/node": "22.20.4",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "vitest": "5.0.2"
  }
}
